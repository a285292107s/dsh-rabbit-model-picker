{
  "name": "dsh-rabbit-model-picker",
  "description": "One-level composer model picker for DeepSeek Harness: shadows the conversation.input.model seat with a search-first single list whose rows state read-only facts (text/image input, reasoning effort, context window) as badges.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "docs/fonts/Archivo-OFL.txt"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "font:build": "node scripts/build-font-asset.mjs",
    "typecheck": "tsc --noEmit",
    "selfcheck": "node scripts/selfcheck-static.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "test:params": "node scripts/test-params.mjs",
    "test:retry": "node scripts/test-retry-policy.mjs",
    "test:recovery": "node scripts/test-rate-limit-recovery.mjs",
    "test:model-config": "node scripts/test-model-config.mjs",
    "test:model-config-copy": "node scripts/test-model-config-copy.mjs",
    "test:mutations": "node scripts/mutate-anchor-loss.mjs",
    "test:mutations:ink": "node scripts/mutate-ink-gates.mjs",
    "test:fresh": "node scripts/check-build-fresh.mjs",
    "theme:fixture": "node scripts/_dump-theme-fixture.mjs",
    "test": "npm run typecheck && npm run build && npm run test:fresh && npm run selfcheck && npm run contrast && npm run test:params && npm run test:retry && npm run test:recovery && npm run test:model-config && npm run test:model-config-copy && npm run test:mutations && npm run test:mutations:ink",
    "prepublishOnly": "npm test"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a285292107s/dsh-rabbit-model-picker.git"
  },
  "bugs": {
    "url": "https://github.com/a285292107s/dsh-rabbit-model-picker/issues"
  },
  "homepage": "https://github.com/a285292107s/dsh-rabbit-model-picker#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "client-plugin",
    "model-picker"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.6.0"
  }
}
